{
  "name": "ntu-course-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.2.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.core.json",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:arch": "node --test tests/architecture/*.test.mjs",
    "test": "npm run test:unit && npm run test:arch",
    "verify": "npm run build && npm test",
    "build": "npm run typecheck && vite build",
    "tauri": "tauri"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "oxc-parser": "0.149.0",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
