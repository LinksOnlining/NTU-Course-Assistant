<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <Binary Id="LwAutoCleanupDll" SourceFile="$(sys.SOURCEFILEDIR)autostart-cleanup.dll" />

    <!-- The deferred action resolves MSI UserSID and opens HKEY_USERS explicitly. -->
    <CustomAction
      Id="SetLinksWorkplaceAutostartCleanupData"
      Property="RemoveLinksWorkplaceAutostart"
      Value="[INSTALLDIR]links-workplace.exe"
    />
    <CustomAction
      Id="RemoveLinksWorkplaceAutostart"
      BinaryKey="LwAutoCleanupDll"
      DllEntry="RemoveLinksWorkplaceAutostart"
      Execute="deferred"
      Impersonate="no"
      Return="check"
      HideTarget="yes"
    />
    <InstallExecuteSequence>
      <Custom Action="SetLinksWorkplaceAutostartCleanupData" Before="RemoveLinksWorkplaceAutostart">
        REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE
      </Custom>
      <Custom Action="RemoveLinksWorkplaceAutostart" Before="RemoveFiles">
        REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE
      </Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
