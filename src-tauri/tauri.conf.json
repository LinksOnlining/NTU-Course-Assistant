{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NTU Course Assistant",
  "version": "1.3.0",
  "identifier": "com.ntu-course-assistant.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "大学课程表", "width": 1280, "height": 800, "minWidth": 720, "minHeight": 520 }],
      "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://tauri.localhost" }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzODMxOTlGMjY1OUM3OEEKUldTS3gxa21ueG1EODVlRHlvUHgzQU4wS3ViaklVYnFZalA3R1ZJc092RW42SENScWplSTRGQTEK",
      "endpoints": [
        "https://github.com/LinksOnlining/NTU-Course-Assistant/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
